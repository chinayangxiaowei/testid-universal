{
  "name": "testid-universal",
  "version": "0.1.0",
  "description": "Framework-agnostic build-time TestID engine: semantic key -> fingerprint -> deterministic id -> versioned registry -> diff -> locators.",
  "license": "MIT",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "testid": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "ts-node examples/demo.ts",
    "demo:vue": "ts-node examples/vue-demo.ts",
    "cli": "ts-node src/cli.ts",
    "serve": "ts-node src/server/http.ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vue/compiler-sfc": "^3.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
    "vitest": "^4.1.8",
    "@angular/compiler": "^20.0.0",
    "@babel/parser": "^7.25.0"
  },
  "peerDependencies": {
    "@vue/compiler-sfc": "^3.0.0",
    "@angular/compiler": "^17.0.0 || ^18.0.0 || ^19.0.0 || ^20.0.0",
    "@babel/parser": "^7.20.0"
  },
  "peerDependenciesMeta": {
    "@vue/compiler-sfc": {
      "optional": true
    },
    "@angular/compiler": {
      "optional": true
    },
    "@babel/parser": {
      "optional": true
    }
  }
}