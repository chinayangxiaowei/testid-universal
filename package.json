{
  "name": "testid-universal",
  "version": "0.1.0",
  "description": "Know which e2e tests to rerun after any code change: stable data-testid anchors + source-dependency tracking for Vue, React, Angular and HTML.",
  "keywords": [
    "data-testid",
    "testid",
    "test-automation",
    "e2e",
    "e2e-testing",
    "end-to-end-testing",
    "playwright",
    "cypress",
    "selenium",
    "webdriverio",
    "test-maintenance",
    "test-impact-analysis",
    "regression-test-selection",
    "selective-testing",
    "locators",
    "vue",
    "react",
    "angular",
    "ci"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chinayangxiaowei/testid-universal.git"
  },
  "homepage": "https://github.com/chinayangxiaowei/testid-universal#readme",
  "bugs": {
    "url": "https://github.com/chinayangxiaowei/testid-universal/issues"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "testid": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "ts-node examples/demo.ts",
    "demo:vue": "ts-node examples/vue-demo.ts",
    "cli": "ts-node src/cli.ts",
    "serve": "ts-node src/server/http.ts"
  },
  "devDependencies": {
    "@angular/compiler": "^20.0.0",
    "@babel/parser": "^7.25.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.11.0",
    "@vue/compiler-sfc": "^3.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "@angular/compiler": "^17.0.0 || ^18.0.0 || ^19.0.0 || ^20.0.0",
    "@babel/parser": "^7.20.0",
    "@vue/compiler-sfc": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@vue/compiler-sfc": {
      "optional": true
    },
    "@angular/compiler": {
      "optional": true
    },
    "@babel/parser": {
      "optional": true
    }
  }
}
